# Configuration checklist only. No credentials belong in this file or frontend VITE variables.
# Application adapters exist; real storage/Defender/queue resources and acceptance remain required.
SPRING_PROFILES_ACTIVE=staging
ENTRA_ISSUER_URI=https://login.microsoftonline.com/71beefd7-29f4-4b9e-9cb2-e78b5dc851ad/v2.0
# API token audience must be verified against an actual access token, not inferred from the scope URI.
ENTRA_AUDIENCE=REPLACE_WITH_VERIFIED_API_AUDIENCE
STAGING_CORS_ORIGINS=https://REPLACE_WITH_STAGING_FRONTEND_HOST
DB_URL=jdbc:postgresql://REPLACE_WITH_PRIVATE_DB_HOST:5432/mmaug_claims?sslmode=verify-full
DB_USERNAME=REPLACE_WITH_APPLICATION_DB_USER
# DB_PASSWORD: supply through the selected secret manager/environment, not this tracked template.
# PII_ENCRYPTION_KEY: backend secret reference, exactly 32 UTF-8 bytes, required in staging.
# Keep the same key for existing encrypted data; rotation requires a separate migration/rollback plan.
DOCINTEL_ENDPOINT=https://mmaug-claims-docintel-01.cognitiveservices.azure.com/
AI_ENDPOINT=https://mmaug-claims-openai-01.openai.azure.com/
AI_DEPLOYMENT=gpt-6.1-sol
STORAGE_BLOB_ENDPOINT=https://REPLACE_WITH_ACCOUNT.blob.core.windows.net
# Optional user-assigned managed identity client ID; blank selects the host's system identity.
STORAGE_MANAGED_IDENTITY_CLIENT_ID=
DEFENDER_QUEUE_ENDPOINT=https://REPLACE_WITH_ACCOUNT.queue.core.windows.net/defender-results
DEFENDER_EXPECTED_TOPIC=/subscriptions/9a2ab22e-5269-4da3-a16a-eeed2b0c09aa/resourceGroups/rg_mmaug_insurance/providers/Microsoft.EventGrid/topics/REPLACE_WITH_DEFENDER_RESULT_TOPIC
# DOCINTEL_KEY and AI_KEY: backend secret references only. Never paste values into chat.
# Provider choices are forced to azure by application-staging.yml.
# Disable all frontend VITE_DEV_BYPASS_AUTH settings in the eventual staging build.
