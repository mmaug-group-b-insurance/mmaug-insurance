# Database
DB_URL=jdbc:postgresql://localhost:5432/mmaug_claims
DB_USERNAME=postgres
DB_PASSWORD=

# Microsoft Entra ID
ENTRA_ISSUER_URI=https://login.microsoftonline.com/{tenant-id}/v2.0
ENTRA_AUDIENCE=api://mmaug-claims-api

# Storage
STORAGE_ACCOUNT_NAME=
STORAGE_QUARANTINE_CONTAINER=quarantine
STORAGE_CLEAN_CONTAINER=clean
STORAGE_PATH=./storage

# AI (backend secret environment only)
AI_KEY=
DOCINTEL_KEY=
AI_ENDPOINT=
AI_DEPLOYMENT=
DOCINTEL_ENDPOINT=

# Internal tools
TOOLS_BASE_URL=http://localhost:8080/internal/tools/v1

# PII encryption key: exactly 32 UTF-8 bytes; required outside local/dev/test. Backend secret only.
PII_ENCRYPTION_KEY=

# Application version metadata
APP_VERSION=1.0.0-SNAPSHOT
PROMPT_VERSION=v1
TOOL_VERSION=v1
RULES_VERSION=1.0.0

# Swagger (disable in production)
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# Spring profile
SPRING_PROFILES_ACTIVE=local